# NOC FAQs Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection URI
# For local development: mongodb://localhost:27017/nocfaqs
# For production: mongodb://username:password@host:port/database
MONGO_URI=mongodb://localhost:27017/nocfaqs

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret key for token generation
# IMPORTANT: Change this to a unique, secure string in production!
# Use a random string of at least 32 characters
JWT_SECRET=your_secure_jwt_secret_key_here

# JWT token expiration time
# Examples: '24h', '7d', '30d'
JWT_EXPIRES_IN=24h

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# Use '*' for development only, specify exact origins in production
# CORS_ORIGIN=http://localhost:3000

# =============================================================================
# LOGGING
# =============================================================================

# Enable detailed error logging in development
# Set to 'false' in production
DEBUG=true
